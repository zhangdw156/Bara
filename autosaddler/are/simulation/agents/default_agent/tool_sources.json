  "implementation": "Independent agent-side translation of the published algorithms; source code is linked, not vendored.",
  "activation": "The published patches do not define task-ID, universe-ID, or keyword routing. Disclose only when their original public prerequisites exist; preserve pre-existing native additions.",
  "algorithms": {
    "get_crime_rates_batch": {
      "patch": "I-08 -> I-11",
      "preserved": [
        "input order and duplicates",
        "one native quota charge per ZIP",
        "skip exact missing-ZIP errors",
        "propagate rate-limit failures"
      ],
      "differences": [
        "one native event per ZIP instead of one app batch event",
        "each native call may recheck cooldown; no atomic multi-ZIP snapshot"
      ]
    },
    "get_email_addresses_in_folder": {
      "patch": "I-13 -> I-14",
      "preserved": [
        "unique sorted senders",
        "unique sorted recipients including cc",
        "folder selection"
      ],
      "differences": [
        "native list pagination instead of direct folder access",
        "detected changes in totals or repeated IDs fail; other concurrent changes may be undetected"
      ]
    },
    "get_all_participants_v1": {
      "patch": "I-13 -> I-14",
      "preserved": [
        "unique sorted names",
        "exclude Me"
      ],
      "differences": [
        "native conversation pagination instead of direct collection access"
      ]
    },
    "get_all_participants_v2": {
      "patch": "I-13 -> I-14",
      "preserved": [
        "unique sorted participant IDs",
        "exclude current user"
      ],
      "differences": [
        "current identity resolved through public contact and messaging tools; extension withheld when those prerequisites are absent",
        "native conversation pagination"
      ]
    },
    "search_contacts": {
      "patch": "I-06 -> I-08",
      "preserved": [
        "case-insensitive substring matching",
        "original name/phone/email and both full-name orders",
        "additional city/country/nationality/job/address fields",
        "native result order"
      ],
      "differences": [
        "complete native contact pagination instead of direct collection access"
      ]
    },
    "search_ride_history": {
      "patch": "I-24 -> I-25",
      "preserved": [
        "UTC date filter",
        "case-insensitive origin and destination filters",
        "original indexes",
        "matching_rides, total_matches, total_rides output"
